<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inicio de sesion</title>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <!-- Botón "Volver al Inicio" agregado aquí -->
  <a href="/" class="inicio"><h2>Volver al Inicio</h2></a>
  
  <div class="sobre-mi"></div>
<form class="form" action="/auth/login" method="POST">
    <h2>Inicio De Sesion</h2>

    <div class="flex-column">
      <label>Email</label>
    </div>
    <div class="inputForm">
        <input type="email" class="input" name="email" placeholder="Ingrese su email" required>
    </div>
    
    <div class="flex-column">
      <label>Contraseña</label>
    </div>
    <div class="inputForm">
        <input type="password" class="input" name="password" placeholder="Ingrese su contraseña" required>
    </div>

    <div class="flex-row">
      <div>
        <input type="checkbox" name="remember">
        <label>Recuerdamelo</label>
      </div>
      <a href="/auth/forgot"><span class="span">¿Olvidó su contraseña?</span></a>
    </div>

    <button class="button-submit" type="submit">Sign In</button>

    <p class="p">¿No tienes cuenta? 
      <a href="/auth/register"><span class="span">Registrarse</span></a>
    </p>
</form>


<br>
<br>
<div class="sobre-mi">


</div>
</body>
</html>